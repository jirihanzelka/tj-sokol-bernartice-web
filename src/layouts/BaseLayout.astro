---
import '@fontsource-variable/manrope';
import '@phosphor-icons/web/regular';
import '../styles/global.css';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import { site, type NavigationId } from '../data/site';
import { sitePath } from '../utils/urls';

interface Props {
  title: string;
  description?: string;
  activeNav?: NavigationId;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  activeNav,
  image,
  noindex = false,
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.shortName}`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const imagePath = image ?? sitePath('images/hero-odra-community.webp');
const socialImage = !noindex && Astro.site ? new URL(imagePath, Astro.site) : undefined;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="sitemap" href={sitePath('sitemap-index.xml')} />
    <link rel="icon" type="image/png" href={sitePath(site.logoPath)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přejít na obsah</a>
    <SiteHeader activeNav={activeNav} />
    <main id="obsah">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
