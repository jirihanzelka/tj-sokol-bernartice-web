---
import { Image } from 'astro:assets';
import { historyPhotos } from '../../data/content';
---

<div class="gallery-grid">
  {historyPhotos.map((photo, index) => (
    <figure class:list={['gallery-item', { wide: index === 3 }]}>
      <a href={photo.image.src} target="_blank" aria-label={`Otevřít fotografii: ${photo.label}`}>
        <Image
          src={photo.image}
          alt={photo.alt}
          widths={[360, 560, 840]}
          sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 33vw"
          loading="lazy"
        />
      </a>
      <figcaption>
        <span>{String(index + 1).padStart(2, '0')}</span>
        {photo.label}
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .gallery-item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    margin: 0;
  }

  .gallery-item.wide { grid-column: span 2; }

  .gallery-item a {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #d8d7d2;
  }

  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    filter: grayscale(100%);
    object-fit: cover;
    transition: filter 180ms ease, transform 220ms ease;
  }

  .gallery-item a:hover :global(img),
  .gallery-item a:focus-visible :global(img) {
    filter: grayscale(20%);
    transform: scale(1.02);
  }

  figcaption {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 8px;
    padding: 14px 0 22px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    font-weight: 620;
  }

  figcaption span { color: var(--red); font-variant-numeric: tabular-nums; }

  @media (max-width: 820px) {
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 540px) {
    .gallery-grid { grid-template-columns: 1fr; }
    .gallery-item.wide { grid-column: auto; }
  }
</style>
