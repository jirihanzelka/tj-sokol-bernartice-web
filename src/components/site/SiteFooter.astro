---
import { site } from '../../data/site';
import { sitePath } from '../../utils/urls';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <section>
      <p class="eyebrow red">Podpora</p>
      <h2>Pomáhají nám.</h2>
      <nav class="footer-links" aria-label="Odkazy v patičce">
        <a href={sitePath(site.supportPath)}>Podpora a partneři</a>
      </nav>
    </section>

    <section class="footer-contact" aria-labelledby="footer-contact-title">
      <p class="eyebrow red">Kontakt a vedení</p>
      <h2 id="footer-contact-title">Kontakt na TJ.</h2>
      <dl>
        <div class="organization-detail">
          <dt>Organizace</dt>
          <dd>{site.legalName}</dd>
          <dd>IČO {site.registrationNumber}</dd>
        </div>
        <div>
          <dt>Předseda</dt>
          <dd>{site.chair.name}</dd>
          <dd><a href={site.chair.phoneHref}>{site.chair.phone}</a></dd>
        </div>
        <div>
          <dt>Sídlo</dt>
          <dd>
            <address>
              {site.registeredOffice.street}<br />
              {site.registeredOffice.city}
            </address>
          </dd>
        </div>
      </dl>
    </section>
  </div>
  <p>© {year} {site.name}</p>
</footer>

<style>
  .footer-content {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(56px, 9vw, 120px);
  }

  .footer-contact dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px 48px;
    margin: 32px 0 0;
  }

  .footer-contact dl > div {
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .footer-contact .organization-detail { grid-column: 1 / -1; }

  .footer-contact dt {
    margin-bottom: 8px;
    color: var(--red);
    font-size: 12px;
    font-weight: 720;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .footer-contact dd {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 17px;
  }

  .footer-contact address { font-style: normal; }

  .footer-contact a {
    color: var(--ink);
    font-weight: 680;
    text-underline-offset: 5px;
  }

  @media (max-width: 820px) {
    .footer-content { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .footer-contact dl { grid-template-columns: 1fr; }
    .footer-contact .organization-detail { grid-column: auto; }
  }
</style>
