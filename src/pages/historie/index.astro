---
import { Image } from 'astro:assets';
import GalleryGrid from '../../components/history/GalleryGrid.astro';
import HistoryTimeline from '../../components/history/HistoryTimeline.astro';
import { historyMilestones, historyPhotos } from '../../data/content';
import ContentLayout from '../../layouts/ContentLayout.astro';

const featurePhoto = historyPhotos[0];
---

<ContentLayout
  title="Historie a galerie"
  description="Více než sto let pohybu, dobrovolnictví a společného života TJ Sokol Bernartice nad Odrou."
  eyebrow="Od roku 1919"
  activeNav="history"
>
  <section class="history-feature" aria-labelledby="history-feature-title">
    <Image
      src={featurePhoto.image}
      alt={featurePhoto.alt}
      widths={[720, 1100, 1600]}
      sizes="100vw"
      loading="eager"
    />
    <div class="history-shade" aria-hidden="true"></div>
    <div class="history-feature-copy">
      <p>Bernartice nad Odrou</p>
      <h2 id="history-feature-title">Pohyb. Přátelství. Obec.</h2>
      <span>Klubový příběh začal 2. listopadu 1919.</span>
    </div>
  </section>

  <section class="milestones" aria-labelledby="milestones-title">
    <div class="history-heading">
      <p class="eyebrow red">Příběh v datech</p>
      <h2 id="milestones-title">Milníky, které utvářely Sokol.</h2>
      <p>
        Výběr vychází z klubové prezentace „Historie tělovýchovné jednoty 1919–2009“.
        Dochovaný podklad končí rokem 2009; novější období zatím není redakčně doložené.
      </p>
    </div>
    <ol class="milestone-list">
      {historyMilestones.map((item) => (
        <li>
          <p>{item.year}</p>
          <div>
            <h3>{item.title}</h3>
            <span>{item.text}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="chronicle" aria-labelledby="chronicle-title">
    <div class="history-heading compact">
      <p class="eyebrow red">Dochovaná kronika</p>
      <h2 id="chronicle-title">Čtyři období. 1919–2009.</h2>
      <p>Obrazové přehledy jsme zachovali v čitelné podobě; každý lze otevřít v plné velikosti.</p>
    </div>
    <HistoryTimeline />
  </section>

  <section class="gallery" aria-labelledby="gallery-title">
    <div class="history-heading compact">
      <p class="eyebrow red">Z klubového archivu</p>
      <h2 id="gallery-title">Fotografie, které stojí za uchování.</h2>
      <p>
        První čtyři snímky mají původní dataci. Popisky ostatních pouze popisují viditelný
        obsah; osoby, místo a datum nejsou archivně ověřené.
      </p>
    </div>
    <GalleryGrid />
  </section>
</ContentLayout>

<style>
  .history-feature {
    position: relative;
    display: flex;
    min-height: min(760px, 78vh);
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
    background: #28342d;
  }

  .history-feature > :global(picture),
  .history-feature > :global(img),
  .history-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .history-feature :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 48%; }
  .history-shade { background: rgba(0, 0, 0, 0.38); }

  .history-feature-copy {
    position: relative;
    z-index: 1;
    max-width: 1050px;
    padding: 0 clamp(30px, 7.8vw, 120px) clamp(64px, 9vw, 130px);
  }
  .history-feature-copy p { margin-bottom: 14px; font-weight: 680; }
  .history-feature-copy h2 { margin-bottom: 22px; font-size: clamp(48px, 7vw, 104px); line-height: 0.98; letter-spacing: -0.065em; }
  .history-feature-copy span { font-size: clamp(18px, 2vw, 26px); }

  .milestones,
  .chronicle,
  .gallery { padding: clamp(80px, 10vw, 150px) clamp(30px, 7.8vw, 120px); }
  .chronicle { background: var(--soft); }

  .milestones {
    display: grid;
    grid-template-columns: minmax(260px, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(50px, 9vw, 150px);
  }
  .history-heading { align-self: start; }
  .milestones .history-heading { position: sticky; top: 110px; }
  .history-heading h2 { margin-bottom: 22px; font-size: clamp(38px, 4.8vw, 70px); line-height: 1.03; letter-spacing: -0.055em; }
  .history-heading > p:last-child { max-width: 600px; margin-bottom: 0; color: var(--muted); font-size: 17px; }
  .history-heading.compact { max-width: 920px; margin-bottom: 64px; }

  .milestone-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .milestone-list li { display: grid; grid-template-columns: 120px 1fr; gap: 26px; padding: 28px 0 34px; border-bottom: 1px solid var(--line); }
  .milestone-list li > p { color: var(--red); font-size: 15px; font-weight: 720; font-variant-numeric: tabular-nums; }
  .milestone-list h3 { margin: 0 0 7px; font-size: clamp(21px, 2vw, 28px); letter-spacing: -0.035em; }
  .milestone-list span { color: var(--muted); }

  @media (max-width: 860px) {
    .milestones { grid-template-columns: 1fr; }
    .milestones .history-heading { position: static; }
  }
  @media (max-width: 560px) {
    .history-feature-copy,
    .milestones,
    .chronicle,
    .gallery { padding-inline: 20px; }
    .history-feature { min-height: 620px; }
    .milestone-list li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
