---
import { clubSections, venues } from '../data/content';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/urls';

const quickLinks = [
  { href: sitePath('program/'), label: 'Co se děje' },
  { href: sitePath('sportoviste/'), label: 'Kam chodit sportovat' },
  { href: sitePath('historie/'), label: 'Poznat náš příběh' },
];
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <img
      class="hero-image"
      src={sitePath('images/hero-odra-community.webp')}
      alt="Děti, dospělí a senioři sportují na louce u řeky Odry"
      width="1821"
      height="864"
      fetchpriority="high"
    />
    <div class="hero-shade" aria-hidden="true"></div>

    <div class="hero-content">
      <p class="eyebrow">TJ Sokol <span aria-hidden="true">•</span> od roku 1919</p>
      <h1 id="hero-title">Jsme v pohybu<span>.</span></h1>
      <p class="hero-lead">Sport a setkávání pro všechny generace.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={sitePath('oddily/')}>
          Objevit oddíly
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
        <a class="button button-ghost" href={sitePath('program/')}>
          Nejbližší akce
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <nav class="quick-links" aria-label="Rychlé odkazy">
    {quickLinks.map((link) => (
      <a href={link.href}>
        <span>{link.label}</span>
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>
    ))}
  </nav>

  <section class="next-event" id="program" aria-labelledby="event-title">
    <i class="ph ph-calendar-dots event-icon" aria-hidden="true"></i>
    <div class="event-copy">
      <p>Aktuální program</p>
      <h2 id="event-title">Termíny právě ověřujeme</h2>
      <div class="event-meta">
        <span><i class="ph ph-info" aria-hidden="true"></i> Žádné zastaralé ani smyšlené akce</span>
      </div>
    </div>
    <a class="text-link" href={sitePath('program/')}>
      Otevřít program
      <i class="ph ph-arrow-right" aria-hidden="true"></i>
    </a>
  </section>

  <section class="content-section sections" id="oddily" aria-labelledby="sections-title">
    <div class="section-heading">
      <p class="eyebrow red">Najděte si svůj pohyb</p>
      <h2 id="sections-title">Šest oddílů. Jeden Sokol.</h2>
      <p>Fotbal, volejbal, florbal, nohejbal, turistika a sport pro všechny.</p>
    </div>
    <div class="section-list">
      {clubSections.map((section) => (
        <a href={sitePath(`oddily/${section.slug}/`)}>
          <span>{section.number}</span>
          <strong>{section.name}</strong>
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      ))}
    </div>
  </section>

  <section class="content-section places" id="mista" aria-labelledby="places-title">
    <div class="section-heading">
      <p class="eyebrow red">Naše zázemí</p>
      <h2 id="places-title">Sportujeme doma u Odry.</h2>
      <a class="inline-link" href={sitePath('sportoviste/')}>
        Prohlédnout sportoviště
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
    <div class="place-list">
      {venues.map((venue) => (
        <p><strong>{venue.name}</strong><span>{venue.summary}</span></p>
      ))}
    </div>
  </section>

  <section class="club-strip" id="klub" aria-labelledby="club-title">
    <p class="eyebrow">Od roku 1919</p>
    <h2 id="club-title">Pohyb. Přátelství. Obec.</h2>
    <p>Více než sto let společných zážitků, dobrovolnictví a sportu v Bernarticích nad Odrou.</p>
    <a class="history-link" href={sitePath('historie/')}>
      Objevit historii a galerii
      <i class="ph ph-arrow-right" aria-hidden="true"></i>
    </a>
  </section>

</BaseLayout>

<style>
  .inline-link,
  .history-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 24px;
    margin-top: 24px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--red);
    color: var(--red);
    font-weight: 700;
    text-decoration: none;
  }

  .history-link {
    margin-top: 38px;
    border-color: #fff;
    color: #fff;
  }

</style>
