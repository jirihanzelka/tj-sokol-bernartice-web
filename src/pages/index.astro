---
import '@fontsource-variable/manrope';
import '@phosphor-icons/web/regular';

const base = import.meta.env.BASE_URL;
const assetBase = base.endsWith('/') ? base : `${base}/`;

const quickLinks = [
  { href: '#program', label: 'Co se děje' },
  { href: '#mista', label: 'Kam chodit sportovat' },
  { href: '#kontakt', label: 'Jak se zapojit' },
];

const sections = [
  { name: 'Fotbal', href: 'https://tjbernasticenadodrou.webnode.cz/kopana/' },
  { name: 'Volejbal', href: 'https://tjbernasticenadodrou.webnode.cz/volejbal/' },
  { name: 'Florbal', href: 'https://tjbernasticenadodrou.webnode.cz/florbal/' },
  { name: 'Nohejbal', href: 'https://tjbernasticenadodrou.webnode.cz/nohejbal/' },
  { name: 'Turistika', href: 'https://tjbernasticenadodrou.webnode.cz/turistika/' },
  { name: 'ASPV', href: 'https://tjbernasticenadodrou.webnode.cz/aspv/' },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="TJ Sokol Bernartice nad Odrou — sport a setkávání pro všechny generace."
    />
    <link rel="icon" type="image/png" href={`${assetBase}images/sokol-symbol.png`} />
    <title>TJ Sokol Bernartice nad Odrou</title>
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přejít na obsah</a>

    <header class="site-header" aria-label="Hlavní navigace">
      <a class="brand" href="#top" aria-label="TJ Sokol Bernartice nad Odrou — úvod">
        <img src={`${assetBase}images/sokol-symbol.png`} alt="" width="64" height="64" />
        <span class="brand-name"><strong>TJ Sokol</strong> Bernartice nad Odrou</span>
      </a>

      <nav class="desktop-nav" aria-label="Hlavní menu">
        <a href="#program">Program</a>
        <a href="#oddily">Oddíly</a>
        <a href="#klub">Klub</a>
        <span aria-hidden="true"></span>
        <a class="contact-link" href="#kontakt">Kontakt</a>
      </nav>

      <button
        class="menu-button"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Otevřít menu"
      >
        <i class="ph ph-list" aria-hidden="true"></i>
      </button>

      <div class="mobile-menu" id="mobile-menu" hidden>
        <a href="#program">Program</a>
        <a href="#oddily">Oddíly</a>
        <a href="#mista">Sportoviště</a>
        <a href="#klub">Klub</a>
        <a href="#kontakt">Kontakt</a>
      </div>
    </header>

    <main id="obsah">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src={`${assetBase}images/hero-odra-community.webp`}
          alt="Děti, dospělí a senioři sportují na louce u řeky Odry"
          width="1821"
          height="864"
          fetchpriority="high"
        />
        <div class="hero-shade" aria-hidden="true"></div>

        <div class="hero-content">
          <p class="eyebrow">TJ Sokol <span aria-hidden="true">•</span> od roku 1919</p>
          <h1 id="hero-title">Jsme v pohybu<span>.</span></h1>
          <p class="hero-lead">Sport a setkávání pro všechny generace.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#oddily">
              Objevit oddíly
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
            <a class="button button-ghost" href="#program">
              Nejbližší akce
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </section>

      <nav class="quick-links" aria-label="Rychlé odkazy">
        {quickLinks.map((link) => (
          <a href={link.href}>
            <span>{link.label}</span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        ))}
      </nav>

      <section class="next-event" id="program" aria-labelledby="event-title">
        <i class="ph ph-calendar-blank event-icon" aria-hidden="true"></i>
        <div class="event-copy">
          <p>Sobota 5. září</p>
          <h2 id="event-title">Turnaj smíšených družstev</h2>
          <div class="event-meta">
            <span><i class="ph ph-map-pin" aria-hidden="true"></i> Sportovní hala</span>
            <span><i class="ph ph-clock" aria-hidden="true"></i> 10:00</span>
          </div>
        </div>
        <a
          class="text-link"
          href="https://tjbernasticenadodrou.webnode.cz/kalendar/"
          target="_blank"
          rel="noreferrer"
        >
          Celý kalendář
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </section>

      <section class="content-section sections" id="oddily" aria-labelledby="sections-title">
        <div class="section-heading">
          <p class="eyebrow red">Najděte si svůj pohyb</p>
          <h2 id="sections-title">Šest oddílů. Jeden Sokol.</h2>
          <p>Od týmových sportů po turistiku a pohyb pro všechny věkové skupiny.</p>
        </div>
        <div class="section-list">
          {sections.map((section, index) => (
            <a href={section.href} target="_blank" rel="noreferrer">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{section.name}</strong>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </section>

      <section class="content-section places" id="mista" aria-labelledby="places-title">
        <div class="section-heading">
          <p class="eyebrow red">Naše zázemí</p>
          <h2 id="places-title">Sportujeme doma u Odry.</h2>
        </div>
        <div class="place-list">
          <p><strong>Sportovní hala</strong><span>Tréninky, turnaje a cvičení</span></p>
          <p><strong>Antukové hřiště</strong><span>Volejbal a letní pohyb</span></p>
          <p><strong>Fotbalové hřiště</strong><span>Zápasy a tréninky u řeky</span></p>
        </div>
      </section>

      <section class="club-strip" id="klub" aria-labelledby="club-title">
        <p class="eyebrow">Od roku 1919</p>
        <h2 id="club-title">Pohyb. Přátelství. Obec.</h2>
        <p>Jsme otevřený klub pro děti, dospělé, seniory, fanoušky i dobrovolníky.</p>
      </section>
    </main>

    <footer id="kontakt">
      <div>
        <p class="eyebrow red">Kontakt</p>
        <h2>Přijďte mezi nás.</h2>
      </div>
      <p>© 2026 TJ Sokol Bernartice nad Odrou</p>
    </footer>

    <script is:inline>
      const button = document.querySelector('.menu-button');
      const menu = document.querySelector('#mobile-menu');

      const closeMenu = () => {
        if (!button || !menu) return;
        menu.hidden = true;
        button.setAttribute('aria-expanded', 'false');
        button.setAttribute('aria-label', 'Otevřít menu');
        const icon = button.querySelector('i');
        icon?.classList.remove('ph-x');
        icon?.classList.add('ph-list');
      };

      button?.addEventListener('click', () => {
        if (!menu) return;
        const opening = menu.hidden;
        menu.hidden = !opening;
        button.setAttribute('aria-expanded', String(opening));
        button.setAttribute('aria-label', opening ? 'Zavřít menu' : 'Otevřít menu');
        const icon = button.querySelector('i');
        icon?.classList.toggle('ph-list', !opening);
        icon?.classList.toggle('ph-x', opening);
      });

      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 820) closeMenu();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color: #151515;
    background: #ffffff;
    font-family: 'Manrope Variable', 'Helvetica Neue', Arial, sans-serif;
    font-synthesis: none;
    --red: #e60013;
    --ink: #151515;
    --line: #dedede;
    --soft: #f5f5f3;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    min-width: 320px;
    color: var(--ink);
    background: #fff;
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 8px;
    left: 8px;
    padding: 10px 14px;
    color: #fff;
    background: var(--red);
    transform: translateY(-160%);
  }

  .skip-link:focus { transform: translateY(0); }

  .site-header {
    position: absolute;
    z-index: 10;
    top: 26px;
    left: clamp(20px, 4.8vw, 72px);
    display: flex;
    width: calc(100% - clamp(40px, 9.6vw, 144px));
    min-height: 100px;
    align-items: center;
    gap: 36px;
    padding: 14px 30px 14px 34px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.96);
  }

  .brand {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 20px;
    text-decoration: none;
  }

  .brand img {
    width: 72px;
    height: 72px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .brand-name {
    display: flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
    font-size: clamp(18px, 1.45vw, 23px);
    letter-spacing: -0.035em;
  }

  .brand-name strong {
    font-size: 1.2em;
    font-weight: 780;
  }

  .desktop-nav {
    display: flex;
    margin-left: auto;
    align-items: center;
    gap: clamp(26px, 3.6vw, 56px);
    font-size: 18px;
  }

  .desktop-nav a {
    padding: 12px 0;
    text-decoration: none;
    text-underline-offset: 6px;
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
  }

  .desktop-nav span {
    width: 1px;
    height: 28px;
    background: #d4d4d4;
  }

  .desktop-nav .contact-link { color: var(--red); }

  .menu-button {
    display: grid;
    width: 52px;
    height: 52px;
    flex: 0 0 auto;
    place-items: center;
    border: 0;
    color: var(--ink);
    background: transparent;
    cursor: pointer;
    font-size: 34px;
  }

  .mobile-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(320px, calc(100vw - 40px));
    padding: 12px;
    border-radius: 20px;
    background: #fff;
  }

  .mobile-menu[hidden] { display: none; }

  .mobile-menu a {
    display: flex;
    min-height: 48px;
    align-items: center;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .mobile-menu a:last-child {
    border-bottom: 0;
    color: var(--red);
  }

  .hero {
    position: relative;
    display: flex;
    min-height: 756px;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
    background: #29412f;
  }

  .hero-image,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    object-fit: cover;
    object-position: center center;
  }

  .hero-shade { background: rgba(2, 10, 6, 0.18); }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(680px, calc(100% - 48px));
    margin: 0 0 150px clamp(28px, 5.7vw, 86px);
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .eyebrow.red { color: var(--red); }

  h1,
  h2,
  p { margin-top: 0; }

  h1 {
    max-width: 780px;
    margin-bottom: 12px;
    font-size: clamp(58px, 6vw, 92px);
    font-weight: 760;
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  h1 span { color: var(--red); }

  .hero-lead {
    margin-bottom: 36px;
    font-size: clamp(20px, 1.7vw, 25px);
    font-weight: 560;
    letter-spacing: -0.025em;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .button {
    display: inline-flex;
    min-height: 64px;
    align-items: center;
    justify-content: center;
    gap: 42px;
    padding: 0 26px;
    border-radius: 5px;
    font-size: 18px;
    font-weight: 650;
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .button:hover { transform: translateY(-2px); }

  .button-primary {
    min-width: 266px;
    color: var(--red);
    background: #fff;
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    color: #fff;
    background: var(--red);
  }

  .button-ghost {
    min-height: 48px;
    padding-inline: 0;
    border-bottom: 2px solid rgba(255, 255, 255, 0.8);
    border-radius: 0;
    color: #fff;
  }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    min-height: 112px;
    border-bottom: 1px solid var(--line);
    background: #fff;
  }

  .quick-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 clamp(28px, 5.5vw, 88px);
    border-right: 1px solid var(--line);
    font-size: clamp(20px, 1.9vw, 28px);
    font-weight: 720;
    letter-spacing: -0.04em;
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .quick-links a:last-child { border-right: 0; }

  .quick-links i {
    color: var(--red);
    font-size: 28px;
    transition: transform 160ms ease;
  }

  .quick-links a:hover,
  .quick-links a:focus-visible {
    color: var(--red);
    background: #fafafa;
  }

  .quick-links a:hover i { transform: translateX(6px); }

  .next-event {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    min-height: 190px;
    align-items: center;
    gap: 52px;
    padding: 34px clamp(30px, 7.8vw, 120px);
    border-bottom: 1px solid var(--line);
  }

  .event-icon {
    color: var(--red);
    font-size: 66px;
  }

  .event-copy > p {
    margin-bottom: 8px;
    color: var(--red);
    font-size: 17px;
    font-weight: 640;
  }

  .event-copy h2 {
    margin-bottom: 12px;
    font-size: clamp(27px, 2.4vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.045em;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 26px;
    color: #535353;
    font-size: 17px;
  }

  .event-meta span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    padding: 10px 0;
    border-bottom: 2px solid var(--red);
    color: var(--red);
    font-size: 18px;
    font-weight: 680;
    text-decoration: none;
  }

  .content-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) 1.6fr;
    gap: clamp(50px, 9vw, 150px);
    padding: clamp(84px, 9vw, 140px) clamp(30px, 7.8vw, 120px);
  }

  .section-heading h2,
  .club-strip h2,
  footer h2 {
    margin-bottom: 20px;
    font-size: clamp(38px, 4.8vw, 70px);
    line-height: 1.03;
    letter-spacing: -0.055em;
  }

  .section-heading > p:last-child {
    max-width: 500px;
    color: #5d5d5d;
    font-size: 18px;
  }

  .section-list { border-top: 1px solid var(--line); }

  .section-list a {
    display: grid;
    grid-template-columns: 54px 1fr auto;
    min-height: 78px;
    align-items: center;
    gap: 18px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .section-list a > span {
    color: var(--red);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .section-list strong {
    font-size: clamp(22px, 2.3vw, 34px);
    letter-spacing: -0.04em;
  }

  .section-list i {
    color: var(--red);
    font-size: 25px;
    transition: transform 160ms ease;
  }

  .section-list a:hover i,
  .section-list a:focus-visible i { transform: translate(4px, -4px); }

  .places { background: var(--soft); }
  .place-list { border-top: 1px solid #cfcfcb; }

  .place-list p {
    display: flex;
    min-height: 86px;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin: 0;
    border-bottom: 1px solid #cfcfcb;
  }

  .place-list strong { font-size: 22px; }

  .place-list span {
    color: #676767;
    text-align: right;
  }

  .club-strip {
    padding: clamp(90px, 12vw, 170px) clamp(30px, 7.8vw, 120px);
    color: #fff;
    background: var(--red);
  }

  .club-strip h2 { max-width: 920px; }

  .club-strip > p:last-child {
    max-width: 680px;
    margin: 0;
    color: #d0d0d0;
    font-size: 19px;
  }

  footer {
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    gap: 40px;
    padding: 90px clamp(30px, 7.8vw, 120px) 44px;
  }

  footer > p {
    grid-column: 1 / -1;
    margin: 50px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: #747474;
  }

  :focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  .quick-links :focus-visible,
  .next-event :focus-visible,
  .content-section :focus-visible,
  footer :focus-visible,
  .site-header :focus-visible { outline-color: var(--red); }

  @media (max-width: 1100px) {
    .brand-name {
      flex-direction: column;
      gap: 0;
      line-height: 1.15;
    }

    .desktop-nav { gap: 24px; }
    .hero-content { margin-bottom: 130px; }
  }

  @media (max-width: 820px) {
    .site-header {
      top: 16px;
      left: 16px;
      width: calc(100% - 32px);
      min-height: 76px;
      padding: 10px 14px;
      border-radius: 20px;
    }

    .brand { gap: 12px; }

    .brand img {
      width: 52px;
      height: 52px;
    }

    .brand-name { font-size: 14px; }
    .desktop-nav { display: none; }
    .menu-button { margin-left: auto; }
    .hero { min-height: 720px; }
    .hero-image { object-position: 64% center; }
    .hero-shade { background: rgba(2, 10, 6, 0.38); }

    .hero-content {
      width: calc(100% - 40px);
      margin: 0 20px 50px;
    }

    .eyebrow { font-size: 15px; }
    h1 { font-size: clamp(50px, 15vw, 72px); }
    .hero-lead { font-size: 19px; }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
      gap: 12px;
    }

    .button {
      width: 100%;
      justify-content: space-between;
    }

    .quick-links { grid-template-columns: 1fr; }

    .quick-links a {
      min-height: 82px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .quick-links a:last-child { border-bottom: 0; }

    .next-event {
      grid-template-columns: auto 1fr;
      padding-block: 46px;
    }

    .event-icon { font-size: 48px; }

    .text-link {
      grid-column: 1 / -1;
      justify-self: start;
      margin-left: 78px;
    }

    .content-section {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .place-list p {
      align-items: flex-start;
      justify-content: flex-start;
      flex-direction: column;
      gap: 4px;
      padding: 18px 0;
    }

    .place-list span { text-align: left; }
    footer { grid-template-columns: 1fr; }
  }

  @media (max-width: 520px) {
    .brand-name {
      max-width: 185px;
      white-space: normal;
    }

    .brand-name strong { font-size: 16px; }

    .menu-button {
      width: 44px;
      height: 44px;
      font-size: 29px;
    }

    .hero-content { margin-bottom: 34px; }

    .next-event {
      gap: 18px;
      padding-inline: 20px;
    }

    .event-meta {
      flex-direction: column;
      gap: 6px;
    }

    .text-link { margin-left: 66px; }

    .content-section,
    .club-strip,
    footer { padding-inline: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }

    *,
    *::before,
    *::after { transition-duration: 0.01ms !important; }
  }
</style>
