---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Připravujeme nové stránky TJ Sokol Bernartice nad Odrou." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>TJ Sokol Bernartice nad Odrou</title>
    <style>
      :root { font-family: system-ui, sans-serif; color: #172033; background: #f4f7f5; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; }
      main { width: min(42rem, 100%); padding: clamp(2rem, 7vw, 4rem); background: white; border-top: .5rem solid #b3262d; box-shadow: 0 1rem 3rem #17203318; }
      p:first-of-type { color: #b3262d; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
      h1 { margin: .4rem 0 1rem; font-size: clamp(2rem, 8vw, 4rem); line-height: 1; }
      p { font-size: 1.1rem; line-height: 1.6; }
      a { color: #8d171d; }
    </style>
  </head>
  <body>
    <main>
      <p>Tělovýchovná jednota</p>
      <h1>TJ Sokol Bernartice nad Odrou</h1>
      <p>Připravujeme nové oficiální stránky. Zatím můžete navštívit <a href="https://tjbernasticenadodrou.webnode.cz/">stávající web TJ</a>.</p>
    </main>
  </body>
</html>
