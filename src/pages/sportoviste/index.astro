---
import VenueCard from '../../components/venues/VenueCard.astro';
import { venues } from '../../data/content';
import ContentLayout from '../../layouts/ContentLayout.astro';
---

<ContentLayout
  title="Sportoviště"
  description="Tři sportoviště TJ Sokol Bernartice nad Odrou s polohou převzatou z původního klubového webu."
  eyebrow="Naše zázemí"
  activeNav="venues"
>
  <section class="venue-intro">
    <p class="eyebrow red">Sportujeme doma</p>
    <h2>Tělocvična, antuka a hřiště u Odry.</h2>
    <p>
      U každého místa uvádíme souřadnice převzaté z původního klubového webu a přímý
      odkaz do mapy. Historické roky, současné využití ani provozní informace původní zdroj
      spolehlivě nedokládá, proto je nedoplňujeme.
    </p>
  </section>

  <div class="venue-list">
    {venues.map((venue, index) => <VenueCard venue={venue} index={index} />)}
  </div>
</ContentLayout>

<style>
  .venue-intro {
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
    gap: 30px clamp(50px, 8vw, 130px);
    padding: clamp(74px, 9vw, 130px) clamp(30px, 7.8vw, 120px);
  }

  .venue-intro .eyebrow { grid-column: 1; }
  .venue-intro h2 {
    grid-column: 1;
    margin: 0;
    font-size: clamp(38px, 4.7vw, 70px);
    line-height: 1.03;
    letter-spacing: -0.055em;
  }
  .venue-intro > p:last-child { grid-column: 2; align-self: end; max-width: 650px; margin: 0; color: var(--muted); font-size: 18px; }

  @media (max-width: 820px) {
    .venue-intro { grid-template-columns: 1fr; }
    .venue-intro .eyebrow,
    .venue-intro h2,
    .venue-intro > p:last-child { grid-column: 1; }
  }

  @media (max-width: 520px) {
    .venue-intro { padding-inline: 20px; }
  }
</style>
